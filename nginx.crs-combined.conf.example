# Contoh Nginx: CRS (IoT-QR-Consumer) + MS Inspection Entry
# Domain: crs.moof-set.web.id
# Sesuaikan port CRS (proxy_pass) dengan PORT di .env IoT-QR-Consumer (production: 5567).

server {
    listen 443 ssl http2;
    server_name crs.moof-set.web.id;
    client_max_body_size 32k;

    # ssl_certificate     /etc/letsencrypt/live/crs.moof-set.web.id/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/crs.moof-set.web.id/privkey.pem;

    # --- MS Inspection Entry ---
    location /api/scans {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/admin/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/inspection/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /inspection/ {
        proxy_pass http://127.0.0.1:3100/inspection/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /inspection {
        return 301 /inspection/;
    }

    # --- IoT-QR-Consumer (CRS) ---
    location / {
        proxy_pass http://127.0.0.1:5567;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name crs.moof-set.web.id;
    return 301 https://$host$request_uri;
}
